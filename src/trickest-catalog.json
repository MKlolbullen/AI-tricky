        "domain",
        "wordlist"
      ],
      "outputs": [
        "targets"
      ],
      "targets": [
        "domain",
        "wordlist"
      ],
      "args": [],
      "risk": "passive",
      "secrets": [],
      "command": [
        "mksub",
        "-d",
        "{domain}",
        "-w",
        "{wordlist_file}",
        "-l",
        "2",
        "-t",
        "4"
