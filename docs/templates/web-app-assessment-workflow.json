{
  "id": "tpl-web-app-assessment",
  "name": "Web Application Assessment",
  "category": "Web Assessment",
  "targets": [
    "domain"
  ],
  "description": "Structured web application assessment: subdomain discovery, live-host probing, crawling, saved HTTP evidence, web source and API Surface analysis, Nuclei detections, bounded path fuzzing and an evidence-only specialist review. Follows the 0xlolbullen.com Web Application Penetration Testing methodology. Outputs are observations and candidates, never confirmed findings.",
  "availability": "adapter-required",
  "sourceCatalog": "curated",
  "starter": "web-app-assessment",
  "steps": [
    "Selected enumeration domains",
    "subfinder + assetfinder",
    "httprobe",
    "Katana",
    "HTTP evidence capture",
    "Web source collector",
    "API Surface",
    "Nuclei (bundled starter templates)",
    "ffuf (bind a wordlist)",
    "CAI specialist team review (evidence only)",
    "Evidence summary"
  ],
  "source": "https://0xlolbullen.com/pentest-methodology",
  "provenance": "Derived from the Victor \u00c5hgren / 0xlolbullen.com Web Application Penetration Testing methodology. Built by the server from catalog tool contracts and native AI-tricky nodes.",
  "license": "MIT",
  "schema": "offsecs-u-ai.workflow/v1",
  "nodes": [
    {
      "id": "domains",
      "type": "tool",
      "position": {
        "x": 0,
        "y": 100
      },
      "data": {
        "kind": "catalog_source",
        "timeout": 120,
        "retries": 0,
        "sourceType": "domain",
        "inputs": [],
        "outputs": [
          "domain"
        ],
        "output": "domain",
        "title": "Selected enumeration domains",
        "value": ""
      }
    },
    {
