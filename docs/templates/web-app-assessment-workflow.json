        "y": 0
      },
      "data": {
        "kind": "catalog_tool",
        "timeout": 120,
        "retries": 0,
        "inputs": [
          "domain"
        ],
        "outputs": [
          "targets"
        ],
        "output": "targets",
        "title": "subfinder",
        "toolId": "subfinder"
      }
    },
    {
